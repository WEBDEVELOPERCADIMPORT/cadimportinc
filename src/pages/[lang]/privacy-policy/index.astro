---
import Layout from "../../../layouts/Layout.astro";
import { LANGUAGES, type Lang } from "../../../i18n/config.i18n";
import privacyContent from "../../../data/site-privacy-content.json";

const lang = (Astro.params.lang as Lang) || "en";

// 1. Validar idioma
if (!(lang in LANGUAGES) || !(lang in privacyContent)) {
  return Astro.redirect("/404");
}

const content = (privacyContent as any)[lang] ?? (privacyContent as any).en;
const {
  meta,
  hero,
  intro,
  interpretationDefinitions,
  collectingAndUsing,
  detailedProcessing,
  gdpr,
  facebookFanPage,
  ccpa,
} = content;
---

<Layout
  title={meta.title}
  lang={lang}
  description={meta.description}
  canonicalPath="privacy-policy"
>
  <main class="w-full bg-white">
    {/* Hero Banner with Corporate Navy Gradient */}
    <section
      class="relative min-h-[220px] sm:min-h-[280px] flex items-center overflow-hidden border-b-4 border-[#76b800] text-white"
    >
      <img
        src="/images/contact/cart-hero.png"
        alt="CAD Import Inc Privacy Policy"
        class="absolute inset-0 w-full h-full object-cover object-center"
        loading="eager"
      />
      <div
        class="absolute inset-0 bg-gradient-to-r from-[#0b3c61] via-[#0b3c61]/60 via-30% to-transparent"
      >
      </div>

      <div
        class="relative z-10 w-full max-w-5xl mx-auto px-6 sm:px-10 lg:px-12 py-12 sm:py-16"
      >
        <h1
          class="text-3xl sm:text-5xl font-black tracking-tight text-white leading-tight font-sans"
        >
          {hero.title}
        </h1>
        <p class="mt-3 text-xs sm:text-sm text-slate-200 font-medium">
          {hero.lastUpdated}
        </p>
      </div>
    </section>

    {/* Content Container */}
    <article
      class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-10 py-12 sm:py-16 text-slate-700 leading-relaxed font-sans text-sm sm:text-base space-y-10"
    >
      {/* Intro */}
      <section data-animate="fade-up" class="space-y-4">
        <p>{intro.p1}</p>
        <p>{intro.p2}</p>
      </section>

      {/* Interpretation and Definitions */}
      <section
        data-animate="fade-up"
        class="space-y-4 pt-6 border-t border-slate-200"
      >
        <h2
          class="text-2xl sm:text-3xl font-extrabold text-[#013764] tracking-tight"
        >
          {interpretationDefinitions.title}
        </h2>

        <h3 class="text-lg sm:text-xl font-bold text-[#013764] pt-2">
          {interpretationDefinitions.interpretationTitle}
        </h3>
        <p>{interpretationDefinitions.interpretationText}</p>

        <h3 class="text-lg sm:text-xl font-bold text-[#013764] pt-2">
          {interpretationDefinitions.definitionsTitle}
        </h3>
        <p>{interpretationDefinitions.definitionsIntro}</p>

        <ul class="list-disc pl-6 space-y-2">
          {
            interpretationDefinitions.items.map((item: any) => (
              <li>
                <strong>{item.term}</strong> {item.def}
              </li>
            ))
          }
        </ul>
      </section>

      {/* Collecting and Using Your Personal Data */}
      <section
        data-animate="fade-up"
        class="space-y-4 pt-6 border-t border-slate-200"
      >
        <h2
          class="text-2xl sm:text-3xl font-extrabold text-[#013764] tracking-tight"
        >
          {collectingAndUsing.title}
        </h2>

        <h3 class="text-lg sm:text-xl font-bold text-[#013764] pt-2">
          {collectingAndUsing.typesTitle}
        </h3>

        <h4 class="font-bold text-[#013764]">
          {collectingAndUsing.personalDataTitle}
        </h4>
        <p>{collectingAndUsing.personalDataIntro}</p>
        <ul class="list-disc pl-6 space-y-1">
          {
            collectingAndUsing.personalDataItems.map((item: string) => (
              <li>{item}</li>
            ))
          }
        </ul>

        <h4 class="font-bold text-[#013764] pt-3">
          {collectingAndUsing.usageDataTitle}
        </h4>
        {collectingAndUsing.usageDataParagraphs.map((p: string) => <p>{p}</p>)}

        <h4 class="font-bold text-[#013764] pt-3">
          {collectingAndUsing.thirdPartySocialTitle}
        </h4>
        {
          collectingAndUsing.thirdPartySocialParagraphs.map((p: string) => (
            <p>{p}</p>
          ))
        }

        <h4 class="font-bold text-[#013764] pt-3">
          {collectingAndUsing.trackingTitle}
        </h4>
        {collectingAndUsing.trackingParagraphs.map((p: string) => <p>{p}</p>)}

        <div class="space-y-4 pt-2">
          {
            collectingAndUsing.cookiesList.map((cookie: any) => (
              <div class="p-4 rounded-lg bg-slate-50 border border-slate-200 space-y-1 text-xs sm:text-sm">
                <p class="font-bold text-[#013764]">{cookie.name}</p>
                <p>
                  <span class="font-semibold text-slate-600">Type:</span>{" "}
                  {cookie.type}
                </p>
                <p>
                  <span class="font-semibold text-slate-600">
                    Administered by:
                  </span>{" "}
                  {cookie.admin}
                </p>
                <p>
                  <span class="font-semibold text-slate-600">Purpose:</span>{" "}
                  {cookie.purpose}
                </p>
              </div>
            ))
          }
        </div>
        <p class="pt-2">{collectingAndUsing.cookiesMoreInfo}</p>

        <h3 class="text-lg sm:text-xl font-bold text-[#013764] pt-4">
          {collectingAndUsing.useOfDataTitle}
        </h3>
        <p>{collectingAndUsing.useOfDataIntro}</p>
        <ul class="list-disc pl-6 space-y-2">
          {
            collectingAndUsing.purposes.map((item: any) => (
              <li>
                <strong>{item.bold}:</strong> {item.text}
              </li>
            ))
          }
        </ul>

        <p class="pt-3">{collectingAndUsing.sharingIntro}</p>
        <ul class="list-disc pl-6 space-y-2">
          {
            collectingAndUsing.sharingSituations.map((item: any) => (
              <li>
                <strong>{item.bold}:</strong> {item.text}
              </li>
            ))
          }
        </ul>

        <h3 class="text-lg sm:text-xl font-bold text-[#013764] pt-4">
          {collectingAndUsing.retentionTitle}
        </h3>
        {collectingAndUsing.retentionParagraphs.map((p: string) => <p>{p}</p>)}

        <h3 class="text-lg sm:text-xl font-bold text-[#013764] pt-4">
          {collectingAndUsing.transferTitle}
        </h3>
        {collectingAndUsing.transferParagraphs.map((p: string) => <p>{p}</p>)}

        <h3 class="text-lg sm:text-xl font-bold text-[#013764] pt-4">
          {collectingAndUsing.deleteTitle}
        </h3>
        {collectingAndUsing.deleteParagraphs.map((p: string) => <p>{p}</p>)}

        <h3 class="text-lg sm:text-xl font-bold text-[#013764] pt-4">
          {collectingAndUsing.disclosureTitle}
        </h3>
        <h4 class="font-bold text-[#013764]">
          {collectingAndUsing.disclosureBusinessTitle}
        </h4>
        <p>{collectingAndUsing.disclosureBusinessText}</p>

        <h4 class="font-bold text-[#013764] pt-2">
          {collectingAndUsing.disclosureLawTitle}
        </h4>
        <p>{collectingAndUsing.disclosureLawText}</p>

        <h4 class="font-bold text-[#013764] pt-2">
          {collectingAndUsing.disclosureOtherTitle}
        </h4>
        <p>{collectingAndUsing.disclosureOtherIntro}</p>
        <ul class="list-disc pl-6 space-y-1">
          {
            collectingAndUsing.disclosureOtherItems.map((item: string) => (
              <li>{item}</li>
            ))
          }
        </ul>

        <h3 class="text-lg sm:text-xl font-bold text-[#013764] pt-4">
          {collectingAndUsing.securityTitle}
        </h3>
        {collectingAndUsing.securityParagraphs.map((p: string) => <p>{p}</p>)}
      </section>

      {/* Detailed Processing */}
      <section
        data-animate="fade-up"
        class="space-y-4 pt-6 border-t border-slate-200"
      >
        <h2
          class="text-2xl sm:text-3xl font-extrabold text-[#013764] tracking-tight"
        >
          {detailedProcessing.title}
        </h2>
        <p>{detailedProcessing.intro}</p>

        <h3 class="text-lg sm:text-xl font-bold text-[#013764] pt-2">
          {detailedProcessing.analyticsTitle}
        </h3>
        <p>{detailedProcessing.analyticsText}</p>
        <ul class="list-disc pl-6 space-y-3">
          {
            detailedProcessing.analyticsProviders.map((item: any) => (
              <li>
                <strong>{item.name}:</strong> {item.desc}
                {item.linkUrl && (
                  <div class="mt-1">
                    <a
                      href={item.linkUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-[#299898] hover:underline font-medium"
                    >
                      {item.linkText}
                    </a>
                  </div>
                )}
              </li>
            ))
          }
        </ul>

        <h3 class="text-lg sm:text-xl font-bold text-[#013764] pt-3">
          {detailedProcessing.emailMarketingTitle}
        </h3>
        <p>{detailedProcessing.emailMarketingText}</p>
        <ul class="list-disc pl-6 space-y-2">
          {
            detailedProcessing.emailMarketingProviders.map((item: any) => (
              <li>
                <strong>{item.name}:</strong> {item.desc}{" "}
                <a
                  href={item.linkUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-[#299898] hover:underline font-medium"
                >
                  {item.linkText}
                </a>
              </li>
            ))
          }
        </ul>

        <h3 class="text-lg sm:text-xl font-bold text-[#013764] pt-3">
          {detailedProcessing.paymentsTitle}
        </h3>
        {detailedProcessing.paymentsParagraphs.map((p: string) => <p>{p}</p>)}

        <h3 class="text-lg sm:text-xl font-bold text-[#013764] pt-3">
          {detailedProcessing.behavioralRemarketingTitle}
        </h3>
        {
          detailedProcessing.behavioralRemarketingParagraphs.map(
            (p: string) => <p>{p}</p>,
          )
        }
        <ul class="list-disc pl-6 space-y-1">
          {
            detailedProcessing.optOutPlatforms.map((platform: any) => (
              <li>
                <a
                  href={platform.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-[#299898] hover:underline"
                >
                  {platform.name}
                </a>
              </li>
            ))
          }
        </ul>
        <p>{detailedProcessing.mobileOptOutText}</p>
        <div class="space-y-3 pt-2">
          {
            detailedProcessing.vendors.map((vendor: any) => (
              <div class="p-3 bg-slate-50 border border-slate-200 rounded">
                <strong class="text-[#013764]">{vendor.name}:</strong>
                <p class="text-xs sm:text-sm mt-1">{vendor.desc}</p>
              </div>
            ))
          }
        </div>
      </section>

      {/* GDPR Privacy */}
      <section
        data-animate="fade-up"
        class="space-y-4 pt-6 border-t border-slate-200"
      >
        <h2
          class="text-2xl sm:text-3xl font-extrabold text-[#013764] tracking-tight"
        >
          {gdpr.title}
        </h2>
        <h3 class="text-lg sm:text-xl font-bold text-[#013764]">
          {gdpr.legalBasisTitle}
        </h3>
        <p>{gdpr.legalBasisIntro}</p>
        <ul class="list-disc pl-6 space-y-2">
          {
            gdpr.bases.map((basis: any) => (
              <li>
                <strong>{basis.bold}:</strong> {basis.text}
              </li>
            ))
          }
        </ul>

        <h3 class="text-lg sm:text-xl font-bold text-[#013764] pt-3">
          {gdpr.rightsTitle}
        </h3>
        <p>{gdpr.rightsIntro}</p>
        <ul class="list-disc pl-6 space-y-2">
          {
            gdpr.rightsList.map((r: any) => (
              <li>
                <strong>{r.bold}:</strong> {r.text}
              </li>
            ))
          }
        </ul>

        <h3 class="text-lg sm:text-xl font-bold text-[#013764] pt-3">
          {gdpr.exercisingRightsTitle}
        </h3>
        {gdpr.exercisingParagraphs.map((p: string) => <p>{p}</p>)}
      </section>

      {/* Facebook Fan Page */}
      <section
        data-animate="fade-up"
        class="space-y-4 pt-6 border-t border-slate-200"
      >
        <h2
          class="text-2xl sm:text-3xl font-extrabold text-[#013764] tracking-tight"
        >
          {facebookFanPage.title}
        </h2>
        <h3 class="text-lg sm:text-xl font-bold text-[#013764]">
          {facebookFanPage.controllerTitle}
        </h3>
        {facebookFanPage.controllerParagraphs.map((p: string) => <p>{p}</p>)}

        <h3 class="text-lg sm:text-xl font-bold text-[#013764] pt-2">
          {facebookFanPage.insightsTitle}
        </h3>
        {facebookFanPage.insightsParagraphs.map((p: string) => <p>{p}</p>)}
      </section>

      {/* CCPA/CPRA Privacy Notice */}
      <section
        data-animate="fade-up"
        class="space-y-4 pt-6 border-t border-slate-200"
      >
        <h2
          class="text-2xl sm:text-3xl font-extrabold text-[#013764] tracking-tight"
        >
          {ccpa.title}
        </h2>
        <p>{ccpa.intro}</p>

        <h3 class="text-lg sm:text-xl font-bold text-[#013764] pt-2">
          {ccpa.categoriesTitle}
        </h3>
        <p>{ccpa.categoriesNotice}</p>

        <div class="space-y-3 pt-2">
          {
            ccpa.categories.map((cat: any) => (
              <div class="p-3 bg-slate-50 border border-slate-200 rounded text-xs sm:text-sm">
                <p class="font-bold text-[#013764]">{cat.code}</p>
                <p class="mt-1">
                  <span class="font-semibold text-slate-600">Examples:</span>{" "}
                  {cat.examples}
                </p>
                <p class="mt-1">
                  <span class="font-semibold text-slate-600">Collected:</span>{" "}
                  {cat.collected}
                </p>
              </div>
            ))
          }
        </div>

        <p class="pt-2 font-semibold text-slate-800">
          Under CCPA/CPRA, personal information does not include:
        </p>
        <ul class="list-disc pl-6 space-y-1">
          {ccpa.notIncluded.map((item: string) => <li>{item}</li>)}
        </ul>

        <h3 class="text-lg sm:text-xl font-bold text-[#013764] pt-3">
          {ccpa.sourcesTitle}
        </h3>
        <ul class="list-disc pl-6 space-y-2">
          {
            ccpa.sources.map((s: any) => (
              <li>
                <strong>{s.bold}:</strong> {s.text}
              </li>
            ))
          }
        </ul>

        <h3 class="text-lg sm:text-xl font-bold text-[#013764] pt-3">
          {ccpa.useTitle}
        </h3>
        <ul class="list-disc pl-6 space-y-1.5">
          {ccpa.useItems.map((item: string) => <li>{item}</li>)}
        </ul>

        <h3 class="text-lg sm:text-xl font-bold text-[#013764] pt-3">
          {ccpa.disclosureTitle}
        </h3>
        <p>{ccpa.disclosureText}</p>

        <h3 class="text-lg sm:text-xl font-bold text-[#013764] pt-3">
          {ccpa.shareTitle}
        </h3>
        <p>{ccpa.shareText}</p>

        <h3 class="text-lg sm:text-xl font-bold text-[#013764] pt-3">
          {ccpa.saleTitle}
        </h3>
        {ccpa.saleParagraphs.map((p: string) => <p>{p}</p>)}

        <h3 class="text-lg sm:text-xl font-bold text-[#013764] pt-3">
          {ccpa.minorsTitle}
        </h3>
        {ccpa.minorsParagraphs.map((p: string) => <p>{p}</p>)}

        <h3 class="text-lg sm:text-xl font-bold text-[#013764] pt-3">
          {ccpa.rightsTitle}
        </h3>
        <p>{ccpa.rightsIntro}</p>
        <ul class="list-disc pl-6 space-y-2">
          {
            ccpa.rightsList.map((r: any) => (
              <li>
                <strong>{r.bold}:</strong> {r.text}
              </li>
            ))
          }
        </ul>

        <h3 class="text-lg sm:text-xl font-bold text-[#013764] pt-3">
          {ccpa.exercisingTitle}
        </h3>
        {ccpa.exercisingParagraphs.map((p: string) => <p>{p}</p>)}

        <h3 class="text-lg sm:text-xl font-bold text-[#013764] pt-3">
          {ccpa.doNotSellTitle}
        </h3>
        {ccpa.doNotSellParagraphs.map((p: string) => <p>{p}</p>)}

        <h3 class="text-lg sm:text-xl font-bold text-[#013764] pt-3">
          {ccpa.sensitiveTitle}
        </h3>
        {ccpa.sensitiveParagraphs.map((p: string) => <p>{p}</p>)}

        <h3 class="text-lg sm:text-xl font-bold text-[#013764] pt-3">
          {ccpa.caloppaTitle}
        </h3>
        {ccpa.caloppaParagraphs.map((p: string) => <p>{p}</p>)}

        <h3 class="text-lg sm:text-xl font-bold text-[#013764] pt-3">
          {ccpa.shineTheLightTitle}
        </h3>
        {ccpa.shineTheLightParagraphs.map((p: string) => <p>{p}</p>)}

        <h3 class="text-lg sm:text-xl font-bold text-[#013764] pt-3">
          {ccpa.minorUsersTitle}
        </h3>
        {ccpa.minorUsersParagraphs.map((p: string) => <p>{p}</p>)}

        <h3 class="text-lg sm:text-xl font-bold text-[#013764] pt-3">
          {ccpa.childrenTitle}
        </h3>
        {ccpa.childrenParagraphs.map((p: string) => <p>{p}</p>)}

        <h3 class="text-lg sm:text-xl font-bold text-[#013764] pt-3">
          {ccpa.linksTitle}
        </h3>
        {ccpa.linksParagraphs.map((p: string) => <p>{p}</p>)}

        <h3 class="text-lg sm:text-xl font-bold text-[#013764] pt-3">
          {ccpa.changesTitle}
        </h3>
        {ccpa.changesParagraphs.map((p: string) => <p>{p}</p>)}

        <h3 class="text-lg sm:text-xl font-bold text-[#013764] pt-3">
          {ccpa.contactTitle}
        </h3>
        <p>{ccpa.contactIntro}</p>
        <p>
          <a
            href={`mailto:${ccpa.contactEmail}`}
            class="text-[#299898] font-bold hover:underline"
          >
            {ccpa.contactEmail}
          </a>
        </p>
      </section>
    </article>
  </main>
</Layout>
