---
import Layout from '../../../layouts/Layout.astro';
import aboutContent from '../../../data/site-about-content.json';
import { LANGUAGES, type Lang } from '../../../i18n/config.i18n';

// Sections
import Hero from '../../../components/about/sections/Hero.astro';
import MissionOverview from '../../../components/about/sections/MissionOverview.astro';
import SupplyChainFlow from '../../../components/about/sections/SupplyChainFlow.astro';
import DistributionSimplified from '../../../components/about/sections/DistributionSimplified.astro';

const lang = Astro.params.lang as Lang;

// 1. Validar idioma
if (!(lang in LANGUAGES) || !(lang in aboutContent)) {
  return Astro.redirect('/404');
}

const content = (aboutContent as Record<string, any>)[lang];
---

<Layout
  title={content.meta?.title ?? "About Us | CAD Import Inc"}
  lang={lang}
  description={content.meta?.description}
  canonicalPath="about-us"
>
  <main class="w-full">
    <Hero lang={lang} />
    <MissionOverview lang={lang} />
    <SupplyChainFlow lang={lang} />
    <DistributionSimplified lang={lang} />
  </main>
</Layout>
