---
import Layout from '../../../layouts/Layout.astro';
import brandsContent from '../../../data/site-brands-content.json';
import { LANGUAGES, type Lang } from '../../../i18n/config.i18n';
import { actions } from 'astro:actions';

// Sections
import Hero from '../../../components/brands/sections/Hero.astro';
import CatalogBanner from '../../../components/common/CatalogBanner.astro';
import BrandCardsGrid from '../../../components/brands/sections/BrandCardsGrid.astro';

const lang = Astro.params.lang as Lang;

// 1. Validar idioma
if (!(lang in LANGUAGES) || !(lang in brandsContent)) {
  return Astro.redirect('/404');
}

const content = (brandsContent as Record<string, any>)[lang];
const card = content.catalogCta ?? {};

// 2. Consultar marcas vía Server Action
const { data: brandsResponse } = await Astro.callAction(actions.getBrands, {});
const brands = brandsResponse?.data ?? [];
---

<Layout
  title={content.meta?.title ?? "Own Brands | CAD Import Inc"}
  lang={lang}
  description={content.meta?.description}
  canonicalPath="own-brands"
>
  <main class="w-full">
    <Hero lang={lang} />
    <CatalogBanner
      variant="large"
      title={card.title ?? "The hispanic population in the U.S is over 62.1 million and growing."}
      subtitle={card.subtitle ?? "Are you carrying the right products to reach this growing audience?"}
      descriptionPrefix={lang === "es" ? "Descargue una copia" : "Download a copy"}
      description={card.description ?? "of our product catalog for a complete listing of goods available form our retail and distribution partners, along with SKU numbers to place your bulk order today."}
      buttonText={card.buttonText ?? (lang === "es" ? "DESCARGA NUESTRO CATÁLOGO" : "DOWNLOAD OUR CATALOG")}
      lang={lang}
    />
    <BrandCardsGrid brands={brands} lang={lang} />
  </main>
</Layout>
