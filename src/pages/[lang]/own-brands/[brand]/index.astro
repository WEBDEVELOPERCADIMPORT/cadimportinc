---
import Layout from '../../../../layouts/Layout.astro';
import { LANGUAGES, type Lang } from '../../../../i18n/config.i18n';
import { actions } from 'astro:actions';

// Sections
import BrandHeader from '../../../../components/brand-detail/sections/BrandHeader.astro';
import ProductsGrid from '../../../../components/brand-detail/sections/ProductsGrid.astro';

const lang = Astro.params.lang as Lang;
const { brand: brandSlug } = Astro.params;

// 1. Validar idioma y parámetro
if (!(lang in LANGUAGES) || !brandSlug) {
  return Astro.redirect('/404');
}

// 2. Consultar marca vía Server Action
const { data: brandResponse, error: brandError } = await Astro.callAction(
  actions.getBrandBySlug,
  { slug: brandSlug }
);

if (brandError || !brandResponse?.data) {
  return Astro.redirect('/404');
}

const brand = brandResponse.data;

// 3. Consultar productos de la marca vía Server Action
const { data: productsResponse } = await Astro.callAction(
  actions.getProductsByBrand,
  { brandSlug, lang }
);

const products = productsResponse?.data ?? [];
---

<Layout
  title={`${brand.name} | CAD Import Inc`}
  lang={lang}
  description={brand.description[lang] || brand.description.en}
  image={brand.logo}
  canonicalPath={`own-brands/${brandSlug}`}
>
  <main class="w-full">
    <BrandHeader brand={brand} lang={lang} />
    <ProductsGrid products={products} lang={lang} />
  </main>
</Layout>
