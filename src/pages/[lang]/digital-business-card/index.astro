---
import Layout from "../../../layouts/Layout.astro";
import pageContent from "../../../data/site-digital-business-card-content.json";
import { LANGUAGES, type Lang } from "../../../i18n/config.i18n";
import { actions } from "astro:actions";
import EmployeeDirectory from "../../../components/digital-business-card/sections/EmployeeDirectory.astro";

const lang = Astro.params.lang as Lang;

if (!(lang in LANGUAGES) || !(lang in pageContent)) {
  return Astro.redirect("/404");
}

const content = pageContent[lang];

const { data: employeesResponse } = await Astro.callAction(
  actions.getEmployees,
  {}
);
const employees = employeesResponse?.data ?? [];
---

<Layout
  title={content.meta.title}
  lang={lang}
  description={content.meta.description}
  canonicalPath="digital-business-card"
>
  <EmployeeDirectory employees={employees} lang={lang} />
</Layout>
