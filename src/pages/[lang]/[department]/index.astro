---
import Layout from "../../../layouts/Layout.astro";
import { LANGUAGES, type Lang } from "../../../i18n/config.i18n";
import { actions } from "astro:actions";
import DepartmentDetailView from "../../../components/department/sections/DepartmentDetailView.astro";
import BrandDetailView from "../../../components/brand-detail/sections/BrandDetailView.astro";

const lang = Astro.params.lang as Lang;
const { department: slug } = Astro.params;

if (!(lang in LANGUAGES) || !slug) {
  return Astro.redirect("/404");
}

// 1. Intentar resolver como Departamento (/:catalog)
const { data: deptResponse, error: deptError } = await Astro.callAction(
  actions.getDepartmentBySlug,
  { slug }
);

const department = !deptError ? deptResponse?.data ?? null : null;

// 2. Si no es departamento, intentar resolver como Marca Propia (/:brand)
let brand = null;
let brandProducts: any[] = [];

if (!department) {
  const { data: brandResponse, error: brandError } = await Astro.callAction(
    actions.getBrandBySlug,
    { slug }
  );

  if (brandError || !brandResponse?.data) {
    return Astro.redirect("/404");
  }

  brand = brandResponse.data;

  if (brand.isRedirect && brand.redirectUrl) {
    return Astro.redirect(brand.redirectUrl);
  }

  const { data: productsResponse } = await Astro.callAction(
    actions.getProductsByBrand,
    { brandSlug: slug, lang }
  );
  brandProducts = productsResponse?.data ?? [];
}

const departmentTitle = department
  ? department.name[lang] || department.name.en
  : "";
---

{department ? (
  <Layout
    title={`${departmentTitle} | CAD Import Inc`}
    lang={lang}
    description={department.heroDescription[lang] || department.heroDescription.en}
    image={department.image}
    canonicalPath={`catalog/${slug}`}
  >
    <DepartmentDetailView department={department} lang={lang} />
  </Layout>
) : brand && (
  <Layout
    title={`${brand.name} | CAD Import Inc`}
    lang={lang}
    description={brand.description[lang] || brand.description.en}
    image={brand.logo}
    canonicalPath={`own-brands/${slug}`}
  >
    <BrandDetailView brand={brand} products={brandProducts} lang={lang} />
  </Layout>
)}
