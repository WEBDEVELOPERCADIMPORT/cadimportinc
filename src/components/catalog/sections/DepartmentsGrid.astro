---
import type { Lang } from '../../../i18n/config.i18n';
import { buildHref } from '../../../i18n/utils.i18n';
import catalogContent from '../../../data/site-catalog-content.json';
import type { DepartmentItem } from '../../../actions/departments/getDepartments.action';

interface Props {
  departments: DepartmentItem[];
  lang: Lang;
}

const { departments, lang } = Astro.props;
const t = catalogContent[lang] ?? catalogContent.en;
const header = t.departmentsHeader;
---

<section class="py-16 bg-slate-50 border-y border-slate-100">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-10">
    
    <div data-animate="fade-up" class="space-y-2">
      <h2 class="text-2xl sm:text-3xl font-black text-[var(--color-cad-navy)] tracking-tight">
        {header.title}
      </h2>
      <p class="text-sm sm:text-base font-semibold text-slate-600">
        {header.subtitle}
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6 sm:gap-8">
      {departments.map((dept, index) => {
        const localizedName = dept.name[lang] || dept.name.en;
        const delay = ((index % 3) * 100).toString();
        return (
          <div data-animate="fade-up" data-animate-delay={delay !== "0" ? delay : undefined}>
            <a
              href={buildHref(lang, `catalog/${dept.slug}`)}
              class="group relative h-48 sm:h-56 rounded-xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 flex items-center justify-center p-4 bg-slate-800"
            >
              <!-- Background Image -->
              <img
                src={dept.image}
                alt={localizedName}
                width="360"
                height="224"
                class="absolute inset-0 w-full h-full object-cover object-center transition duration-500 group-hover:scale-105 opacity-80"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-slate-900/35 group-hover:bg-slate-900/20 transition-colors"></div>

              <!-- Dark Translucent Pill Label -->
              <div class="relative z-10 px-5 py-3 rounded-lg bg-black/60 backdrop-blur-xs border border-white/20 text-white font-extrabold text-xs sm:text-sm tracking-widest uppercase text-center shadow-lg group-hover:bg-[var(--color-cad-teal)] transition-colors">
                {localizedName}
              </div>
            </a>
          </div>
        );
      })}
    </div>

  </div>
</section>
