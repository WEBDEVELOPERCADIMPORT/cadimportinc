---
import type { Lang } from '../../../i18n/config.i18n';
import contactContent from '../../../data/site-contact-content.json';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = contactContent[lang] ?? contactContent.en;
const hero = t.hero;
---

<section class="relative w-full min-h-[260px] sm:min-h-[320px] flex items-center justify-start overflow-hidden bg-[#0b3c61] text-white">
  {/* Background Image */}
  <img
    src={hero.bgImage}
    alt="CAD Import Retail Shopping Cart"
    class="absolute inset-0 w-full h-full object-cover object-center"
    loading="eager"
  />

  {/* Gradient Overlay: Deep navy on the left fading smoothly to transparent across the right */}
  <div class="absolute inset-0 bg-gradient-to-r from-[#0b3c61] via-[#0b3c61]/60 via-30% to-transparent"></div>

  {/* Content Container aligned to the left */}
  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16 w-full">
    <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white leading-tight font-sans">
      {hero.title}
    </h1>
  </div>
</section>
