---
import type { Lang } from "../../../i18n/config.i18n";
import contactContent from "../../../data/site-contact-content.json";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = contactContent[lang] ?? contactContent.en;
const map = t.map;
---

<section class="w-full bg-slate-100 py-0 border-t border-slate-200 overflow-x-clip">
  <div data-animate="fade-up" class="w-full h-80 sm:h-96 relative">
    <iframe
      src={map.embedUrl}
      width="100%"
      height="100%"
      style="border:0;"
      allowfullscreen=""
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      title={map.title}
      class="w-full h-full filter saturate-100"></iframe>
  </div>
</section>
