---
import type { Lang } from '../../../i18n/config.i18n';
import { buildHref } from '../../../i18n/utils.i18n';
import type { BrandItem } from '../../../actions/brands/getBrands.action';

interface Props {
  brands: BrandItem[];
  lang: Lang;
}

const { brands, lang } = Astro.props;
---

<section class="py-16 sm:py-24 bg-slate-50 border-t border-slate-100">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-8 lg:gap-10 items-stretch">
      {brands.map((brand, index) => {
        const delay = ((index % 3) * 100).toString();
        const isRedirect = Boolean(brand.isRedirect && brand.redirectUrl);
        const ctaHref = isRedirect
          ? brand.redirectUrl!
          : buildHref(lang, `own-brands/${brand.slug}`);
        const isExternalRedirect = isRedirect && /^https?:\/\//i.test(ctaHref);
        return (
        <div
          data-animate="bubble-pop"
          data-animate-delay={delay !== "0" ? delay : undefined}
          class="bg-transparent rounded-2xl transition-all duration-300 p-8 flex flex-col items-center justify-between text-center group"
        >
          
          <!-- Brand Logo Container -->
          <div class="h-40 w-full flex items-center justify-center p-2 mb-6">
            <img
              src={brand.logo}
              alt={brand.name}
              width="350"
              class="max-h-40 max-w-[400px] object-contain transition-transform duration-300 group-hover:scale-105"
              loading="lazy"
            />
          </div>

          <!-- Action Button in Brand Corporate Color -->
          <div class="w-full mt-auto">
            <a
              href={ctaHref}
              target={isExternalRedirect ? "_blank" : undefined}
              rel={isExternalRedirect ? "noopener noreferrer" : undefined}
              style={`background-color: ${brand.badgeColor};`}
              class="w-full text-white font-bold text-xs uppercase tracking-widest py-3 px-6 rounded-md shadow-sm hover:opacity-90 transition-opacity inline-flex items-center justify-center"
            >
              {brand.ctaText[lang] || brand.ctaText.en || "SEE PRODUCTS"}
            </a>
          </div>

        </div>
        );
      })}
    </div>
  </div>
</section>
