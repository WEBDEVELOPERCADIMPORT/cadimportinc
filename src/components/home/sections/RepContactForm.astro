---
import type { Lang } from '../../../i18n/config.i18n';
import homeContent from '../../../data/site-home-content.json';
import PhoneInput from '../../common/PhoneInput.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = homeContent[lang] ?? homeContent.en;
const rep = t.repContact;
---

<section class="relative min-h-[500px] flex items-center overflow-hidden text-white bg-[#0b3c61]">
  {/* Background Image of the Representative */}
  <img
    src={rep.repImage}
    alt="CAD Import Representative"
    class="absolute inset-0 w-full h-full object-cover object-right md:object-center"
    loading="lazy"
  />

  {/* Gradient Overlay: Deep navy on the left fading smoothly to transparent across the right */}
  <div class="absolute inset-0 bg-gradient-to-r from-[#0b3c61] via-[#0b3c61]/60 via-30% to-transparent"></div>

  {/* Content Container: Form strictly aligned to the left, nothing on the right */}
  <div class="relative z-10 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20">
    <div data-animate="slide-in-left" class="max-w-xl text-left space-y-6">
      
      <div class="space-y-2">
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-white tracking-tight leading-tight">
          {rep.title}
        </h2>
        <p class="text-slate-200 font-medium text-sm sm:text-base">
          {rep.subtitle}
        </p>
      </div>

      <form id="cad-rep-contact-form" class="space-y-3.5 max-w-lg">
        <div>
          <label for="rep-name" class="sr-only">{rep.namePlaceholder}</label>
          <input
            type="text"
            id="rep-name"
            name="name"
            placeholder={rep.namePlaceholder}
            class="cad-input bg-white text-slate-800 placeholder:text-slate-400"
            required
          />
        </div>

        <div>
          <label for="rep-email" class="sr-only">{rep.emailPlaceholder}</label>
          <input
            type="email"
            id="rep-email"
            name="email"
            placeholder={rep.emailPlaceholder}
            class="cad-input bg-white text-slate-800 placeholder:text-slate-400"
            required
          />
        </div>

        <div>
          <label class="sr-only">{rep.phonePlaceholder}</label>
          <PhoneInput
            lang={lang}
            placeholder={rep.phonePlaceholder}
            name="phone"
          />
        </div>

        <div>
          <label for="rep-company" class="sr-only">{rep.companyPlaceholder}</label>
          <input
            type="text"
            id="rep-company"
            name="company"
            placeholder={rep.companyPlaceholder}
            class="cad-input bg-white text-slate-800 placeholder:text-slate-400"
          />
        </div>

        <div>
          <label for="rep-message" class="sr-only">{rep.messagePlaceholder}</label>
          <textarea
            id="rep-message"
            name="message"
            rows="3"
            placeholder={rep.messagePlaceholder}
            class="cad-input bg-white text-slate-800 placeholder:text-slate-400 resize-none"
            required
          ></textarea>
        </div>

        <button
          type="submit"
          class="btn-cad-green text-sm font-bold uppercase tracking-wider py-3 shadow-md"
        >
          {rep.submitButton}
        </button>
        
        <p id="cad-rep-feedback" class="text-xs text-center font-semibold text-emerald-400 hidden"></p>
      </form>

    </div>
  </div>
</section>

<script>
  function setupRepForm() {
    const form = document.getElementById('cad-rep-contact-form');
    const feedback = document.getElementById('cad-rep-feedback');
    if (!form || !feedback) return;

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      feedback.textContent = '✓ Message received! A representative will connect with you soon.';
      feedback.classList.remove('hidden');
      (form as HTMLFormElement).reset();
    });
  }

  setupRepForm();
  document.addEventListener('astro:page-load', setupRepForm);
</script>
