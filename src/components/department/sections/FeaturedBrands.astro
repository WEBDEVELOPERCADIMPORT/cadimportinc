---
import type { Lang } from '../../../i18n/config.i18n';
import type { DepartmentItem } from '../../../actions/departments/getDepartments.action';

interface Props {
  department: DepartmentItem;
  lang: Lang;
}

const { department, lang } = Astro.props;
const items = department.items[lang] || department.items.en || [];
const collageImage = department.collageImage || `/images/departments/${department.slug}-collage.png`;
const collageTitle =
  department.collageTitle?.[lang] ||
  department.collageTitle?.en ||
  (lang === 'es' ? 'Productos que sus Clientes Usan a Diario' : 'Products Your Customers Use Everyday');
const checklistTitle =
  department.checklistTitle?.[lang] ||
  department.checklistTitle?.en ||
  (lang === 'es'
    ? 'Marcas de Confianza Para Que Sus Clientes Regresen Por Más'
    : 'Trusted Brands To Keep Your Customers Returning For More');

const half = Math.ceil(items.length / 2);
const col1 = items.slice(0, half);
const col2 = items.slice(half);
---

<section class="py-14 sm:py-20 bg-white overflow-x-clip">
  <div class="max-w-7xl mx-auto px-6 sm:px-10 lg:px-14">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      
      {/* Left Column: Centered Title + Larger Department Collage Image */}
      <div data-animate="slide-in-left" class="lg:col-span-6 flex flex-col items-center space-y-6">
        <h3 class="text-2xl sm:text-3xl font-extrabold text-[#013764] tracking-tight text-center leading-snug max-w-lg">
          {collageTitle}
        </h3>
        
        {/* Image Container with Larger Indicated Size (600 x 600 px) */}
        <div class="relative w-full max-w-[600px] aspect-square mx-auto flex items-center justify-center">
          <img
            src={collageImage}
            alt={collageTitle}
            width="600"
            height="600"
            class="w-full h-full object-contain"
            loading="lazy"
            onerror="this.classList.add('hidden'); if(this.nextElementSibling) this.nextElementSibling.classList.remove('hidden');"
          />
          <div class="hidden w-full h-full rounded-xl border-2 border-dashed border-slate-200 bg-slate-50 flex-col items-center justify-center p-6 text-center text-slate-400">
            <span class="text-xs font-bold uppercase tracking-wider text-slate-500">Collage Placeholder</span>
            <span class="text-[11px] mt-1 font-mono">{collageImage}</span>
            <span class="text-[11px] mt-0.5">(600 x 600 px)</span>
          </div>
        </div>
      </div>

      {/* Right Column: Larger Navy Shopping Basket + Title + Larger 2-Col Checklist */}
      <div data-animate="slide-in-right" class="lg:col-span-6 flex flex-col items-center space-y-8">
        <div class="text-center space-y-4">
          {/* Iconic Navy Shopping Basket (Enlarged) */}
          <svg
            class="w-24 h-24 sm:w-28 sm:h-28 text-[#013764] mx-auto"
            viewBox="0 0 64 64"
            fill="none"
            aria-hidden="true"
          >
            <path d="M22 25L29 13C29.8 11.6 29.3 9.8 27.9 9C26.5 8.2 24.7 8.7 23.9 10.1L15.5 25H22Z" fill="currentColor" />
            <path d="M42 25L35 13C34.2 11.6 34.7 9.8 36.1 9C37.5 8.2 39.3 8.7 40.1 10.1L48.5 25H42Z" fill="currentColor" />
            <rect x="6" y="24" width="52" height="7" rx="3" fill="currentColor" />
            <path d="M10 31H54L49.5 52C49 54.3 47 56 44.6 56H19.4C17 56 15 54.3 14.5 52L10 31Z" fill="currentColor" />
            <rect x="20" y="37" width="4.5" height="13" rx="2.25" fill="white" />
            <rect x="29.75" y="37" width="4.5" height="13" rx="2.25" fill="white" />
            <rect x="39.5" y="37" width="4.5" height="13" rx="2.25" fill="white" />
          </svg>

          <h3 class="text-xl sm:text-2xl font-extrabold text-[#013764] tracking-tight leading-snug max-w-md mx-auto">
            {checklistTitle}
          </h3>
        </div>

        {/* Two Vertical Columns of Products (Enlarged Icons & Typography) */}
        <div class="grid grid-cols-2 gap-x-8 sm:gap-x-12 gap-y-4 w-full max-w-xl pt-2">
          <ul class="space-y-3.5 sm:space-y-4">
            {col1.map((item) => (
              <li class="flex items-start gap-3 text-sm sm:text-base md:text-lg font-medium text-[#013764]">
                <span class="text-[#299898] shrink-0 mt-1">
                  <svg class="w-5 h-5 sm:w-6 sm:h-6 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zM1 2v2h2l3.6 7.59-1.35 2.45c-.16.28-.25.61-.25.96 0 1.1.9 2 2 2h12v-2H7.42c-.14 0-.25-.11-.25-.25l.03-.12.9-1.63h7.45c.75 0 1.41-.41 1.75-1.03l3.58-6.49c.08-.14.12-.31.12-.48 0-.55-.45-1-1-1H5.21l-.94-2H1zm16 16c-1.1 0-1.99.9-1.99 2s.89 2 1.99 2 2-.9 2-2-.9-2-2-2z" />
                  </svg>
                </span>
                <span class="leading-snug">{item}</span>
              </li>
            ))}
          </ul>

          <ul class="space-y-3.5 sm:space-y-4">
            {col2.map((item) => (
              <li class="flex items-start gap-3 text-sm sm:text-base md:text-lg font-medium text-[#013764]">
                <span class="text-[#299898] shrink-0 mt-1">
                  <svg class="w-5 h-5 sm:w-6 sm:h-6 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zM1 2v2h2l3.6 7.59-1.35 2.45c-.16.28-.25.61-.25.96 0 1.1.9 2 2 2h12v-2H7.42c-.14 0-.25-.11-.25-.25l.03-.12.9-1.63h7.45c.75 0 1.41-.41 1.75-1.03l3.58-6.49c.08-.14.12-.31.12-.48 0-.55-.45-1-1-1H5.21l-.94-2H1zm16 16c-1.1 0-1.99.9-1.99 2s.89 2 1.99 2 2-.9 2-2-.9-2-2-2z" />
                  </svg>
                </span>
                <span class="leading-snug">{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>

    </div>
  </div>
</section>
