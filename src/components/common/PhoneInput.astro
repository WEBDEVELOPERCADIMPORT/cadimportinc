---
import type { Lang } from "../../i18n/config.i18n";
import countriesData from "../../data/countries/countries.data.json";

interface Props {
  id?: string;
  name?: string;
  lang?: Lang;
  placeholder?: string;
  required?: boolean;
  seamless?: boolean;
  class?: string;
}

const {
  id = `phone-input-${Math.random().toString(36).substring(2, 9)}`,
  name = "phone",
  lang = "en",
  placeholder = lang === "es" ? "Teléfono" : "Phone",
  required = false,
  seamless = false,
  class: className = "",
} = Astro.props;

const countries = countriesData.countries;
// Default is Guatemala as requested
const defaultCountry = countries.find((c) => c.code === "US") ?? countries[0];
---

<div class={`relative w-full country-phone-wrapper ${className}`} id={id}>
  <div
    class={`relative flex items-center w-full bg-white border border-slate-300 rounded-[4px] focus-within:border-[var(--color-cad-teal)] focus-within:ring-1 focus-within:ring-[var(--color-cad-teal)] transition-all ${seamless ? "h-11" : ""}`}
  >
    {/* Flag selector trigger */}
    <button
      type="button"
      class={`country-btn flex items-center gap-1.5 text-xs font-semibold text-slate-700 transition-colors focus:outline-none cursor-pointer shrink-0 ${
        seamless
          ? "pl-3.5 pr-1.5 py-2 bg-transparent hover:bg-slate-50 rounded-l-[3px]"
          : "px-3 py-2 bg-slate-50 hover:bg-slate-100 border-r border-slate-300 rounded-l-[3px]"
      }`}
      aria-haspopup="listbox"
      aria-expanded="false"
      aria-label="Select Country Code"
    >
      <span class="selected-flag text-base leading-none select-none"
        >{defaultCountry.flag}</span
      >
      <span class="text-[10px] text-slate-500 select-none">▾</span>
    </button>

    {/* Hidden inputs for form submission */}
    <input
      type="hidden"
      name={`${name}DialCode`}
      class="country-dial-code"
      value={defaultCountry.dialCode}
    />
    <input
      type="hidden"
      name={`${name}Country`}
      class="country-iso-code"
      value={defaultCountry.code}
    />

    {/* Phone input */}
    <input
      type="tel"
      name={name}
      placeholder={placeholder}
      required={required}
      class={`phone-field w-full text-xs sm:text-sm text-slate-800 placeholder:text-slate-400 bg-transparent focus:outline-none rounded-r-[3px] ${
        seamless ? "pl-1.5 pr-3.5 py-2" : "px-3 py-2"
      }`}
    />
  </div>

  {/* Country List Dropdown */}
  <div
    class="country-dropdown absolute left-0 top-full mt-1 w-72 sm:w-80 max-h-60 overflow-y-auto bg-white border border-slate-200 rounded-lg shadow-2xl hidden z-50 py-1.5 text-xs text-slate-700 divide-y divide-slate-100"
    role="listbox"
  >
    {
      countries.map((country) => {
        const localizedName =
          country.name[lang as "es" | "en"] ?? country.name.en;
        const isDefault = country.code === defaultCountry.code;
        return (
          <button
            type="button"
            class={`country-option w-full px-3.5 py-2.5 flex items-center justify-between text-left hover:bg-slate-100 transition-colors cursor-pointer ${
              isDefault ? "bg-slate-50 font-semibold" : ""
            }`}
            data-code={country.code}
            data-dial={country.dialCode}
            data-flag={country.flag}
            data-name={localizedName}
            role="option"
            aria-selected={isDefault}
          >
            <div class="flex items-center gap-2.5 overflow-hidden pr-2">
              <span class="text-base shrink-0 select-none">{country.flag}</span>
              <span class="truncate text-slate-800 text-xs sm:text-sm">
                {localizedName}
              </span>
            </div>
            <span class="text-xs font-semibold text-slate-500 shrink-0 select-none">
              {country.dialCode}
            </span>
          </button>
        );
      })
    }
  </div>
</div>

<script>
  function setupCountryPhoneInputs() {
    document
      .querySelectorAll<HTMLElement>(".country-phone-wrapper")
      .forEach((wrapper) => {
        if (wrapper.dataset.bound === "true") return;
        wrapper.dataset.bound = "true";

        const btn = wrapper.querySelector<HTMLButtonElement>(".country-btn");
        const dropdown =
          wrapper.querySelector<HTMLElement>(".country-dropdown");
        const flagDisplay =
          wrapper.querySelector<HTMLElement>(".selected-flag");
        const dialCodeInput =
          wrapper.querySelector<HTMLInputElement>(".country-dial-code");
        const isoCodeInput =
          wrapper.querySelector<HTMLInputElement>(".country-iso-code");
        const phoneInput =
          wrapper.querySelector<HTMLInputElement>(".phone-field");
        const options =
          wrapper.querySelectorAll<HTMLButtonElement>(".country-option");

        if (
          !btn ||
          !dropdown ||
          !flagDisplay ||
          !dialCodeInput ||
          !isoCodeInput
        )
          return;

        const toggleDropdown = (e: Event) => {
          e.stopPropagation();
          const isOpen = !dropdown.classList.contains("hidden");
          // Close any other open dropdowns first
          document
            .querySelectorAll(".country-dropdown")
            .forEach((d) => d.classList.add("hidden"));
          if (!isOpen) {
            dropdown.classList.remove("hidden");
            btn.setAttribute("aria-expanded", "true");
          } else {
            dropdown.classList.add("hidden");
            btn.setAttribute("aria-expanded", "false");
          }
        };

        btn.addEventListener("click", toggleDropdown);

        options.forEach((opt) => {
          opt.addEventListener("click", (e) => {
            e.stopPropagation();
            const dial = opt.dataset.dial ?? "+502";
            const flag = opt.dataset.flag ?? "🇬🇹";
            const code = opt.dataset.code ?? "GT";

            flagDisplay.textContent = flag;
            dialCodeInput.value = dial;
            isoCodeInput.value = code;

            dropdown.classList.add("hidden");
            btn.setAttribute("aria-expanded", "false");

            if (phoneInput) {
              phoneInput.focus();
            }
          });
        });

        document.addEventListener("click", (e) => {
          if (!wrapper.contains(e.target as Node)) {
            dropdown.classList.add("hidden");
            btn.setAttribute("aria-expanded", "false");
          }
        });
      });
  }

  setupCountryPhoneInputs();
  document.addEventListener("astro:page-load", setupCountryPhoneInputs);
</script>
