---
import type { Lang } from '../../i18n/config.i18n';
import globalContent from '../../data/site-global-content.json';

interface Props {
  variant?: 'large' | 'compact';
  title: string;
  subtitle?: string;
  descriptionPrefix?: string;
  description?: string;
  buttonText?: string;
  pdfUrl?: string;
  image?: string;
  imageAlt?: string;
  lang?: Lang;
}

const {
  variant = 'large',
  title,
  subtitle,
  descriptionPrefix = 'Download a copy',
  description = 'of our product catalog for a complete listing of goods available form our retail and distribution partners, along with SKU numbers to place your bulk order today.',
  buttonText = 'DESCARGA NUESTRO CATÁLOGO',
  pdfUrl,
  image,
  imageAlt,
  lang = 'en',
} = Astro.props;

const globalCatalog = (globalContent as any)[lang]?.catalog ?? (globalContent as any).en?.catalog;
const finalPdfUrl = pdfUrl ?? globalCatalog?.pdfUrl ?? '/catalogo.pdf';
const finalImage = image ?? globalCatalog?.image ?? '/images/catalogo.png';
const finalImageAlt = imageAlt ?? globalCatalog?.imageAlt ?? 'catalogo';

const isLarge = variant === 'large';
---

<section class="relative z-20 w-full bg-white overflow-x-clip">
  <div class="max-w-7xl mx-auto px-6 sm:px-10 lg:px-14 pt-4 sm:pt-6 pb-12 sm:pb-16">
    <div class="flex flex-col-reverse md:flex-row items-center justify-between gap-8 md:gap-14">
      
      {/* Columna Izquierda: Textos y Botón */}
      <div class={`text-left w-full ${isLarge ? 'max-w-2xl' : 'max-w-xl'} space-y-4`}>
        <h2 class={`${isLarge ? 'text-2xl sm:text-3xl lg:text-4xl' : 'text-xl sm:text-2xl lg:text-3xl'} font-extrabold text-[#0b3c61] tracking-tight leading-snug font-sans`}>
          {title}
        </h2>

        {subtitle && (
          <p class={`${isLarge ? 'text-base sm:text-lg lg:text-xl' : 'text-sm sm:text-base'} font-bold text-[#0b3c61] leading-relaxed`}>
            {subtitle}
          </p>
        )}

        <p class="text-xs sm:text-sm text-slate-700 leading-relaxed font-normal pt-1">
          {descriptionPrefix && (
            <strong class="font-bold text-slate-900">{descriptionPrefix} </strong>
          )}
          {description}
        </p>

        <div class="pt-3 inline-block" data-animate="slide-in-right">
          <a
            href={finalPdfUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center px-7 sm:px-8 py-3 sm:py-3.5 text-xs sm:text-sm font-bold uppercase tracking-wider text-white bg-[#76b800] hover:bg-[#6aa600] active:bg-[#5d9200] rounded-xs shadow-md transition-all cursor-pointer"
          >
            {buttonText}
          </a>
        </div>
      </div>

      {/* Columna Derecha: Portada del Catálogo sobrepasando el Hero */}
      <div class="shrink-0 relative z-30 flex justify-center w-full md:w-auto">
        <div
          data-animate="bubble-pop"
          class={isLarge
            ? '-mt-16 sm:-mt-24 md:-mt-32 lg:-mt-36 w-56 sm:w-64 md:w-72 lg:w-80'
            : '-mt-12 sm:-mt-20 md:-mt-24 lg:-mt-28 w-48 sm:w-56 md:w-64'
          }
        >
          <a
            href={finalPdfUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={buttonText}
            class="group block w-full shadow-2xl rounded-sm overflow-hidden bg-white border border-slate-200 aspect-[3/4] cursor-pointer transition-transform duration-300 hover:scale-[1.02]"
          >
            <img
              src={finalImage}
              alt={finalImageAlt}
              width={isLarge ? 320 : 256}
              height={isLarge ? 430 : 344}
              class="w-full h-full object-cover transition-opacity duration-200 group-hover:opacity-95"
              loading="lazy"
            />
          </a>
        </div>
      </div>

    </div>
  </div>
</section>
