---
// src/components/common/Footer.astro
import type { Lang } from "../../i18n/config.i18n";
import { getLangFromUrl, buildHref } from "../../i18n/utils.i18n";
import globalContent from "../../data/site-global-content.json";

interface Props {
  lang?: Lang;
}

const { lang: propLang } = Astro.props;
const lang = propLang ?? getLangFromUrl(Astro.url);
const t = ((globalContent as any)[lang] ?? (globalContent as any).es).footer;

// Tamaños fijos de los placeholders de tiendas (presentación)
const storeSizes: Record<string, string> = {
  vasalsuper: "w-[200px] h-[100px]",
  amazon: "w-[200px] h-[100px]",
};
---

<footer class="w-full bg-[#f7f7f7] mt-auto font-sans">
  <div class="w-full px-6 sm:px-10 lg:px-14 py-10 lg:py-12">
    <div
      class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-[80px_minmax(0,1fr)_minmax(0,1fr)_minmax(0,1fr)] gap-x-8 lg:gap-x-10 gap-y-10"
    >
      {/* Column 1: Logo + Social + NMSDC */}
      <div class="flex flex-col items-center gap-5">
        <a
          href={`/${lang}/`}
          class="block w-30 h-30 rounded-full bg-transparent border border-gray-200 overflow-hidden"
          aria-label={t.logo.alt}
        >
          <img
            src={t.logo.src}
            alt={t.logo.alt}
            class="w-full h-full object-contain"
            loading="lazy"
          />
        </a>

        <div class="flex items-center gap-3">
          {
            t.social.map((item: any) => (
              <a
                href={item.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={item.label}
                class="w-[22px] h-[22px] rounded-[4px] bg-[#76b900] hover:bg-[#669f00] text-white flex items-center justify-center transition-colors"
              >
                {item.id === "facebook" ? (
                  <svg
                    class="w-3.5 h-3.5"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path d="M14 8.5V6.8c0-.8.5-1 1-1h2.4V2.1L14.6 2C11.4 2 10.4 4 10.4 6.4v2.1H8v3.8h2.4V22H14v-9.7h3l.4-3.8H14z" />
                  </svg>
                ) : (
                  <svg
                    class="w-3.5 h-3.5"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.4"
                    aria-hidden="true"
                  >
                    <rect x="3.5" y="3.5" width="17" height="17" rx="4.5" />
                    <circle cx="12" cy="12" r="4" />
                    <circle
                      cx="17.3"
                      cy="6.7"
                      r="0.6"
                      fill="currentColor"
                      stroke="none"
                    />
                  </svg>
                )}
              </a>
            ))
          }
        </div>

        {
          t.certification.src ? (
            <img
              src={t.certification.src}
              alt={t.certification.alt}
              class="w-30 h-30 object-contain"
              loading="lazy"
            />
          ) : (
            <div
              class="w-30 h-30"
              role="img"
              aria-label={t.certification.alt}
            />
          )
        }
      </div>

      {/* Column 2: Locations + Careers */}
      <div class="text-[13px] leading-relaxed text-[#333333]">
        <h3 class="text-[13px] font-bold uppercase text-[#0b3c61] mb-4">
          {t.locations.title}
        </h3>
        <p>
          {t.locations.addressLine1}<br />
          {t.locations.addressLine2}
        </p>
        <p class="font-bold mt-4">{t.locations.schedule}</p>
        <a
          href={t.locations.phoneHref}
          class="inline-block mt-4 font-bold text-[#7cb82f] hover:text-[#5f9420] transition-colors"
        >
          {t.locations.phone}
        </a>

        <h3 class="text-[13px] font-bold uppercase text-[#0b3c61] mt-8 mb-4">
          {t.careers.title}
        </h3>
        <a
          href={t.careers.href}
          class="font-bold text-[#7cb82f] hover:text-[#5f9420] transition-colors"
        >
          {t.careers.linkLabel}
        </a>
      </div>

      {/* Column 3: Portfolio Links */}
      <div>
        <h3 class="text-[13px] font-bold uppercase text-[#0b3c61] mb-4">
          {t.portfolio.title}
        </h3>
        <ul class="space-y-2 text-[13px] text-[#333333]">
          {
            t.portfolio.links.map((link: any) => (
              <li>
                <a
                  href={buildHref(lang, link.path)}
                  class="group inline-flex items-center gap-2 text-[#333333] hover:text-[#0b3c61] transition-colors"
                >
                  <span
                    class="text-[#76b900] font-bold leading-none transition-transform group-hover:translate-x-0.5"
                    aria-hidden="true"
                  >
                    ›
                  </span>
                  <span>{link.label}</span>
                </a>
              </li>
            ))
          }
        </ul>
        <div class="mt-5">
          <a
            href={t.portfolio.ctaHref}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center w-full sm:w-auto px-4 py-2 text-[12px] font-semibold text-white bg-[#1bbf5c] hover:bg-[#17a84f] rounded-[3px] transition-colors"
          >
            {t.portfolio.ctaLabel}
          </a>
          <p class="mt-2.5 text-[11px] leading-snug text-gray-500">
            {t.portfolio.note}
          </p>
        </div>
      </div>

      {/* Column 4: Exclusive product lines */}
      <div class="flex flex-col items-center text-center">
        <h3
          class="text-[13px] font-bold uppercase text-[#0b3c61] leading-snug max-w-[220px] mb-4"
        >
          {t.stores.title}
        </h3>
        <div class="flex flex-col items-center gap-4">
          {
            t.stores.items.map((store: any) => (
              <a
                href={store.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={store.alt}
                class={`block ${storeSizes[store.id] ?? "w-[140px] h-[50px]"}`}
              >
                {store.src ? (
                  <img
                    src={store.src}
                    alt={store.alt}
                    class="w-full h-full object-contain"
                    loading="lazy"
                  />
                ) : (
                  <span class="block w-full h-full" />
                )}
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </div>

  {/* Bottom Copyright & Privacy Policy Bar */}
  <div class="w-full bg-[#1e2329] text-slate-400 text-xs py-4 px-4 text-center">
    <span>© 2026 CAD Import Inc. All Rights Reserved.</span>
    <span class="mx-2">-</span>
    <a href={`/${lang}/privacy-policy`} class="hover:text-white transition-colors">
      {lang === 'es' ? 'Política de Privacidad' : 'Privacy Policy'}
    </a>
  </div>
</footer>
